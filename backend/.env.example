# ─── Ellis Backend Environment Variables ─────────────────────────────────────
# Copy this file to .env and populate with real values
# NEVER commit .env to version control — it is listed in .gitignore

# ── Bridge Interactive API ────────────────────────────────────────────────────
# Covers: Stellar MLS (Cotality), Zillow Zestimate, Public Records
# Endpoint: https://api.bridgedataoutput.com/api/v2/
# Docs: https://bridgedataoutput.com/docs/platform
BRIDGE_ACCESS_TOKEN=your_bridge_access_token_here
BRIDGE_DATA_SYSTEM_KEY=stellar

# ── Spark API ─────────────────────────────────────────────────────────────────
# Covers: Daytona, Beaches, Naples, Tallahassee, Space Coast, Vero Beach,
#         Pensacola, Florida Keys, NEFMLS (Jacksonville), New Smyrna Beach,
#         Navica Flagler, Miami MLS, Royal Palm Coast
# Endpoint: https://sparkapi.com/v1/
# Docs: https://sparkplatform.com/docs/api_services/read_first
SPARK_ACCESS_TOKEN=your_spark_access_token_here

# ── Anthropic (Claude AI) ─────────────────────────────────────────────────────
# Powers: advisor recommendations, listing descriptions, market analysis,
#         stale listing alerts, offer analysis
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Google / Gemini ───────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GA4_PROPERTY_ID=your_ga4_property_id_here

# ── Twilio (SMS notifications) ────────────────────────────────────────────────
# Used for: investor subscriber lead alerts, seller showing notifications,
#           offer notifications
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ── Gmail (transactional email) ───────────────────────────────────────────────
# Used for: waitlist confirmations, advisor flow summaries, lead notifications
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# ── DeltaNet (optional — only if needed beyond Bridge/Spark) ─────────────────
DELTANET_CLIENT_ID=your_deltanet_client_id_here
DELTANET_CLIENT_SECRET=your_deltanet_client_secret_here

# ── Server config ─────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to 'true' to enable each data source
ENABLE_BRIDGE=true
ENABLE_SPARK=true
ENABLE_ZESTIMATE=true
ENABLE_OPENDOOR=false
ENABLE_SMS_ALERTS=false
ENABLE_EMAIL=false
